<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_presale_route_salesperson" model="ir.rule">
            <field name="name">Rutas de Preventa: Solo Vendedor Asignado</field>
            <field name="model_id" ref="model_presale_route"/>
            <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="rule_presale_route_manager" model="ir.rule">
            <field name="name">Rutas de Preventa: Administrador de Ventas Ver Todo</field>
            <field name="model_id" ref="model_presale_route"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        </record>

        <record id="rule_presale_visit_salesperson" model="ir.rule">
            <field name="name">Visitas de Preventa: Solo Vendedor Asignado</field>
            <field name="model_id" ref="model_presale_visit"/>
            <field name="domain_force">[('route_id.salesperson_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="rule_presale_visit_manager" model="ir.rule">
            <field name="name">Visitas de Preventa: Administrador de Ventas Ver Todo</field>
            <field name="model_id" ref="model_presale_visit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        </record>
    </data>
</odoo>
