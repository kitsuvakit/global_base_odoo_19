<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_presale_visit_form" model="ir.ui.view">
        <field name="name">presale.visit.form</field>
        <field name="model">presale.visit</field>
        <field name="arch" type="xml">
            <form string="Visita de Preventa">
                <header>
                    <button name="action_open_mobile_catalog" string="🛒 Abrir Catálogo Móvil / Pedido" type="object" class="btn-primary"/>
                    <button name="action_mark_no_sale" string="❌ Registrar No Compra" type="object" class="btn-warning"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,in_visit,sale,no_sale"/>
                </header>
                <sheet>
                    <group>
                        <group string="Detalles de Visita">
                            <field name="partner_id"/>
                            <field name="route_id"/>
                            <field name="visit_date"/>
                        </group>
                        <group string="Resultado de Venta / Incidencia">
                            <field name="sale_order_id"/>
                            <field name="no_sale_reason" invisible="state != 'no_sale'"/>
                            <field name="gps_latitude"/>
                            <field name="gps_longitude"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="📝 Observaciones de Terreno" name="notes">
                            <field name="notes" placeholder="Notas sobre la visita al cliente..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_presale_visit" model="ir.actions.act_window">
        <field name="name">Registro de Visitas</field>
        <field name="res_model">presale.visit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
