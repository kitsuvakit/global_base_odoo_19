<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_presale_route_form" model="ir.ui.view">
        <field name="name">presale.route.form</field>
        <field name="model">presale.route</field>
        <field name="arch" type="xml">
            <form string="Ruta de Preventa Móvil">
                <header>
                    <button name="action_start_route" string="▶️ Iniciar Recorrido" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_finish_route" string="🏁 Finalizar Ruta" type="object" class="btn-success" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej. Ruta Centro - Lunes"/></h1>
                    </div>
                    <group>
                        <group string="Asignación y Fecha">
                            <field name="salesperson_id"/>
                            <field name="warehouse_id"/>
                            <field name="date"/>
                            <field name="day_of_week"/>
                        </group>
                        <group string="Estadísticas del Recorrido">
                            <field name="total_visits"/>
                            <field name="completed_visits"/>
                            <field name="total_sales_amount" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="📍 Visitas Programadas" name="visits">
                            <field name="visit_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="no_sale_reason" optional="show"/>
                                    <field name="sale_order_id"/>
                                    <button name="action_start_visit" string="Iniciar Visita" type="object" class="btn-info" invisible="state != 'pending'"/>
                                    <button name="action_open_mobile_catalog" string="🛒 Tomar Pedido" type="object" class="btn-success" invisible="state not in ('pending', 'in_visit')"/>
                                    <button name="action_mark_no_sale" string="❌ No Compró" type="object" class="btn-secondary" invisible="state not in ('pending', 'in_visit')"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_presale_route_list" model="ir.ui.view">
        <field name="name">presale.route.list</field>
        <field name="model">presale.route</field>
        <field name="arch" type="xml">
            <list string="Rutas de Preventa">
                <field name="name"/>
                <field name="salesperson_id"/>
                <field name="date"/>
                <field name="total_visits"/>
                <field name="completed_visits"/>
                <field name="total_sales_amount" widget="monetary"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_presale_route" model="ir.actions.act_window">
        <field name="name">Rutas de Preventa Móvil</field>
        <field name="res_model">presale.route</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
