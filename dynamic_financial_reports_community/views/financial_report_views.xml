<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_financial_report_wizard_form" model="ir.ui.view">
        <field name="name">financial.report.wizard.form</field>
        <field name="model">financial.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reportes Financieros Dinámicos">
                <header>
                    <button name="action_generate_html_report" string="🔄 Generar / Actualizar Reporte" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Reportes Financieros Dinámicos</h1>
                    </div>
                    <group>
                        <group string="Filtros del Reporte">
                            <field name="report_type"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="target_move"/>
                            <field name="include_closing_entries"/>
                        </group>
                        <group string="Rango de Fechas">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="📊 Vista Reporte Dinámico" name="report_html">
                            <field name="html_report" widget="html" readonly="1" options="{'style-inline': true}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_financial_report_wizard" model="ir.actions.act_window">
        <field name="name">Reportes Financieros Dinámicos</field>
        <field name="res_model">financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
