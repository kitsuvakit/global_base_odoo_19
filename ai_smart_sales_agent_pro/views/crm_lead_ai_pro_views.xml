<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_ai_pro" model="ir.ui.view">
        <field name="name">crm.lead.form.ai.pro</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="ai_smart_sales_agent.crm_lead_view_form_inherit_ai"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_analyze_part_image_with_ai" string="Analizar Foto con Vision AI" type="object" class="btn-info"/>
                <button name="action_generate_quick_payment_link" string="Generar Link de Pago PRO" type="object" class="btn-success"/>
            </xpath>
            <xpath expr="//page[@name='ai_agent']" position="inside">
                <group string="Reconocimiento Visual y Cobros PRO">
                    <group>
                        <field name="ai_part_image" widget="image" class="oe_avatar"/>
                    </group>
                    <group>
                        <field name="payment_link_url"/>
                        <field name="cross_sell_suggestions"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
