<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Form de la Estación de Despacho Rápido -->
    <record id="view_fast_dispatch_station_form" model="ir.ui.view">
        <field name="name">fast.dispatch.station.form</field>
        <field name="model">fast.dispatch.station</field>
        <field name="arch" type="xml">
            <form string="Estación de Despacho Rápido" class="o_fast_dispatch_station" js_class="fast_dispatch_form">
                <header>
                    <button name="action_validate_dispatch" 
                            string="✅ VALIDAR Y DESPACHAR" 
                            type="object" 
                            class="btn-success btn-lg fw-bold px-4 me-2" 
                            invisible="not picking_id or picking_state in ('done', 'cancel')"/>

                    <button name="action_clear" 
                            string="🧹 Limpiar Pantalla" 
                            type="object" 
                            class="btn-secondary me-2"/>

                    <button name="action_refresh_dashboard" 
                            string="🔄 Actualizar Control de Mando" 
                            type="object" 
                            class="btn-outline-primary me-2"/>

                    <field name="picking_state" widget="statusbar" statusbar_visible="draft,waiting,confirmed,assigned,done" invisible="not picking_id"/>
                </header>

                <sheet>
                    <!-- CONTROL DE MANDO (KPIs DEL DÍA) -->
                    <div class="alert alert-info shadow-sm mb-3 border-0 bg-light rounded-3 p-3">
                        <div class="row text-center align-items-center">
                            <div class="col-md-3 border-end">
                                <div class="text-muted small fw-bold">📦 DESPACHADAS HOY</div>
                                <div class="h3 fw-bolder text-success mb-0">
                                    <field name="today_dispatched_count" readonly="1"/>
                                </div>
                            </div>
                            <div class="col-md-3 border-end">
                                <div class="text-muted small fw-bold">⏳ PENDIENTES POR DESPACHAR</div>
                                <div class="h3 fw-bolder text-primary mb-0">
                                    <field name="pending_dispatched_count" readonly="1"/>
                                </div>
                            </div>
                            <div class="col-md-3 border-end">
                                <div class="text-muted small fw-bold">🟢 VENTAS PAGADAS (LISTAS)</div>
                                <div class="h3 fw-bolder text-success mb-0">
                                    <field name="paid_pending_count" readonly="1"/>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted small fw-bold">🔴 SIN PAGAR (CUENTAS POR COBRAR)</div>
                                <div class="h3 fw-bolder text-danger mb-0">
                                    <field name="unpaid_pending_count" readonly="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- BANNER Y BÚSQUEDA POR SCANNER -->
                    <div class="card mb-3 border-primary shadow-sm">
                        <div class="card-body bg-primary-subtle p-3">
                            <h5 class="card-title text-primary fw-bold mb-2">
                                🔍 Escanear Ticket o Código de Producto
                            </h5>
                            <p class="card-text text-muted mb-2">
                                Escanee el código de barras del ticket de venta o número de orden. Una vez cargada la orden, puede pistolear los productos uno a uno para verificarlos o presionar VALIDAR directamente.
                            </p>
                            <div class="input-group input-group-lg">
                                <field name="search_query" 
                                       placeholder="Pistolee el código del ticket u orden aquí..." 
                                       class="form-control fw-bold border-primary search_input_autofocus" 
                                       no_label="1"/>
                                <button name="process_scan_input" 
                                        type="object" 
                                        string="🔎 Buscar / Escanear" 
                                        class="btn btn-primary px-4 fw-bold"/>
                            </div>
                        </div>
                    </div>

                    <!-- MENSAJE DE ESTADO DINÁMICO -->
                    <field name="status_type" invisible="1"/>
                    <div class="alert alert-info mb-3 fw-bold fs-6 shadow-sm" invisible="not status_message">
                        <field name="status_message" readonly="1" no_label="1"/>
                    </div>

                    <!-- DATOS DE LA CABECERA DE LA ORDEN CARGADA -->
                    <group invisible="not picking_id" class="bg-light p-2 rounded mb-3">
                        <group>
                            <field name="picking_id" options="{'no_open': True}"/>
                            <field name="origin"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="location_id"/>
                        </group>
                    </group>

                    <!-- TABLA PRINCIPAL DE PIEZAS A ENTREGAR (PISTOLEO) -->
                    <separator string="📋 PIEZAS A ENTREGAR Y VERIFICACIÓN (PISTOLEO)" invisible="not picking_id"/>
                    
                    <field name="line_ids" invisible="not picking_id">
                        <list editable="bottom" create="0" delete="0"
                              decoration-success="scan_state == 'completed'"
                              decoration-warning="scan_state == 'partial'"
                              decoration-danger="scan_state == 'missing'"
                              decoration-muted="scan_state == 'pending'">
                            <field name="scan_state" widget="badge" 
                                   decoration-success="scan_state == 'completed'"
                                   decoration-warning="scan_state == 'partial'"
                                   decoration-danger="scan_state == 'missing'"
                                   decoration-muted="scan_state == 'pending'"/>
                            <field name="default_code" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="barcode" readonly="1"/>
                            <field name="location_name" readonly="1"/>
                            <field name="qty_demanded" readonly="1" sum="Total Solicitado"/>
                            <field name="scanned_qty" sum="Total Escaneado"/>
                            <field name="qty_to_dispatch" sum="Total a Despachar"/>
                            <field name="is_checked" widget="boolean_toggle"/>
                            <field name="is_missing" invisible="1"/>
                        </list>
                    </field>

                    <!-- RESUMEN FINAL DE METRICAS DEL PISTOLEO -->
                    <div class="row mt-3 mb-4" invisible="not picking_id">
                        <div class="col-md-3">
                            <div class="p-3 border rounded text-center bg-light">
                                <span class="text-muted small">Total Piezas Solicitadas:</span>
                                <div class="h4 fw-bold mb-0 text-dark">
                                    <field name="total_qty_demanded" readonly="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border rounded text-center bg-light">
                                <span class="text-muted small">Total Piezas Escaneadas:</span>
                                <div class="h4 fw-bold mb-0 text-primary">
                                    <field name="total_qty_scanned" readonly="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border rounded text-center bg-light">
                                <span class="text-muted small">Faltante por Escanear:</span>
                                <div class="h4 fw-bold mb-0 text-danger">
                                    <field name="total_qty_missing" readonly="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border rounded text-center bg-light">
                                <span class="text-muted small">Estado del Conteo:</span>
                                <div class="h5 fw-bold mb-0">
                                    <field name="is_fully_scanned" readonly="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CONTROL DE MANDO: PESTAÑAS DE ENTREGAS PENDIENTES -->
                    <separator string="📊 CONTROL DE MANDO DE ENTREGAS PENDIENTES DEL DÍA" class="mt-4 mb-2"/>
                    <notebook>
                        <!-- PESTAÑA 1: VENTAS PAGADAS -->
                        <page string="🟢 Ventas Pagadas por Despachar (Listo para Entregar)">
                            <field name="paid_dashboard_line_ids">
                                <list create="0" delete="0">
                                    <field name="picking_name" readonly="1"/>
                                    <field name="origin" readonly="1"/>
                                    <field name="partner_id" readonly="1"/>
                                    <field name="scheduled_date" readonly="1"/>
                                    <field name="total_qty" readonly="1"/>
                                    <field name="payment_status_label" readonly="1" widget="badge"/>
                                    <button name="action_load_this_picking" 
                                            string="⚡ Cargar y Pistolear" 
                                            type="object" 
                                            class="btn-success btn-sm fw-bold"/>
                                </list>
                            </field>
                        </page>

                        <!-- PESTAÑA 2: VENTAS SIN PAGAR (CUENTAS POR COBRAR) -->
                        <page string="🔴 Ventas Sin Pagar / Cuentas por Cobrar">
                            <field name="unpaid_dashboard_line_ids">
                                <list create="0" delete="0">
                                    <field name="picking_name" readonly="1"/>
                                    <field name="origin" readonly="1"/>
                                    <field name="partner_id" readonly="1"/>
                                    <field name="scheduled_date" readonly="1"/>
                                    <field name="total_qty" readonly="1"/>
                                    <field name="payment_status_label" readonly="1" widget="badge"/>
                                    <button name="action_load_this_picking" 
                                            string="⚡ Cargar y Pistolear" 
                                            type="object" 
                                            class="btn-warning btn-sm fw-bold"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para abrir la Estación de Despacho Rápido -->
    <record id="action_fast_dispatch_station" model="ir.actions.act_window">
        <field name="name">⚡ Estación de Despacho Rápido</field>
        <field name="res_model">fast.dispatch.station</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_fast_dispatch_station_root"
              name="Despacho Rápido"
              action="action_fast_dispatch_station"
              web_icon="fast_dispatch_station,static/description/icon.png"
              sequence="1"/>
</odoo>
